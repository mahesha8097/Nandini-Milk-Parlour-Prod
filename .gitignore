# Dependencies
node_modules/
client/node_modules/

# Environment Variables & Secrets (NEVER COMMIT REAL SECRETS)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.env
!.env.example

# Local SQLite Database Files (Do not commit local test databases to production)
server/data/*.db
server/data/*.db-wal
server/data/*.db-shm
server/data/*.sqlite
server/data/*.sqlite3

# Local Uploads (In production, Supabase Storage is used)
server/uploads/*
!server/uploads/.gitkeep

# Build Artifacts & Vercel
dist/
client/dist/
.vercel/

# Logs & Debug
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor & OS Artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/
