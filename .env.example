# ====================================================================
# NANDINI MILK PARLOUR — ENVIRONMENT VARIABLES EXAMPLE
# ====================================================================
# Copy this file to .env for local configuration or add these variables
# directly into your Vercel Project Settings (Settings -> Environment Variables).
# DO NOT COMMIT REAL PRODUCTION SECRETS TO GIT.
# ====================================================================

# --------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# --------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# --------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# --------------------------------------------------------------------
# In Development: Leave DATABASE_URL empty to use the local SQLite database.
# In Production: Provide the Supabase PostgreSQL connection string.
# (Recommended: Use Supabase Transaction Pooler URI with pgbouncer=true)
# Example: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=
DATABASE_SSL=true
DB_POOL_MAX=10

# --------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# --------------------------------------------------------------------
# Strong random secret for signing authentication JWT tokens in production.
# Generate with: openssl rand -base64 32
JWT_SECRET=your-strong-random-production-jwt-secret

# --------------------------------------------------------------------
# 4. SUPABASE PERSISTENT STORAGE
# --------------------------------------------------------------------
# Required in production for persistent storage of Business Logo, UPI QR, and Signature.
# Create a public bucket in Supabase Storage named "nandini-assets".
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_STORAGE_BUCKET=nandini-assets

# --------------------------------------------------------------------
# 5. CORS & FRONTEND ORIGINS
# --------------------------------------------------------------------
# Comma-separated list of allowed frontend origins for production.
# In production, specify your exact Vercel domain(s). Do NOT use wildcard '*'.
# Example: CORS_ORIGIN=https://nandini-milk-parlour.vercel.app,https://your-custom-domain.com
CORS_ORIGIN=https://your-app-name.vercel.app

# (Frontend Vite Variable) - Leave empty for unified Vercel single-domain deployment (/api)
VITE_API_URL=

# --------------------------------------------------------------------
# 6. AUTOMATED DAILY EMAIL REPORTS (RESEND & VERCEL CRON)
# --------------------------------------------------------------------
# Resend API key (starts with re_...)
RESEND_API_KEY=re_your_resend_api_key_here
# Recipient business email where the daily delivery report should be delivered
ADMIN_REPORT_EMAIL=owner@example.com
# Sender email address. Use onboarding@resend.dev during testing or your verified custom domain
RESEND_FROM_EMAIL=Nandini Milk Parlour <onboarding@resend.dev>
# Secret key to secure the Vercel Cron endpoint (/api/cron/daily-delivery-report)
# Generate with: openssl rand -base64 32
CRON_SECRET=your-random-cron-secret-key
